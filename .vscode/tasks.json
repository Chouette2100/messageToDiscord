{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "go build binary",
            "type": "shell",
            "options": {
                "env": {
                  "CGO_ENABLED": "0",
                }
            },
            "command": "go",
            "args": [
                "build",
                "-v",
                "-o",
                "messageToDiscord",
                "."
            ],
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "go build all packages",
            "type": "shell",
            "command": "go",
            "args": [
                "build",
                "-v",
                "./..."
            ],
            "problemMatcher": []
        }
    ]
}